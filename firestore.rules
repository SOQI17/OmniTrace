
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    function isWarehouse() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'WAREHOUSE';
    }

    function isImporter() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'IMPORTER';
    }

    // ─── Usuarios ─────────────────────────────────────────────────────────────
    // Cada usuario puede leer su propio perfil.
    // Solo ADMIN puede crear, modificar o eliminar perfiles de usuario.
    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAdmin();
    }

    // ─── Activos (Assets) ─────────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer activos.
    // Solo ADMIN, IMPORTER y WAREHOUSE pueden crear o modificar.
    // Solo ADMIN puede eliminar.
    match /assets/{assetId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isImporter() || isWarehouse();
      allow update: if isAdmin() || isImporter() || isWarehouse();
      allow delete: if isAdmin();
    }

    // ─── Auditoría (Audit Log) ────────────────────────────────────────────────
    // Cualquier usuario autenticado puede leer el historial.
    // Cualquier usuario autenticado puede crear registros (append-only).
    // Nadie puede editar o borrar registros de auditoría (integridad del log).
    match /audit_log/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
