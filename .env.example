# ─── OmniTrace — Variables de Entorno ────────────────────────────────────────
# Copia este archivo como .env.local y completa los valores reales.
# NUNCA subas .env.local al repositorio.

# ─── Firebase ────────────────────────────────────────────────────────────────
# Credenciales de tu proyecto en https://console.firebase.google.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─── Cloudinary ──────────────────────────────────────────────────────────────
# Credenciales de tu proyecto en https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
